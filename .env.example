# AgentsGate Environment Variables
# Copy this file to .env and fill in values for your deployment.
# Most variables have defaults suitable for local development.

# ── Proxy ──────────────────────────────────────────────────────────────────────
# Port the MCP proxy listens on (default: 4000)
# AGENTSGATE_PORT=4000

# Upstream MCP server the proxy forwards to (required when using proxy mode)
# AGENTSGATE_UPSTREAM=http://localhost:4001

# ── Dashboard ──────────────────────────────────────────────────────────────────
# Port the dashboard HTTP API listens on (default: 4001)
# AGENTSGATE_DASHBOARD_PORT=4001

# ── Authentication ─────────────────────────────────────────────────────────────
# API key required to access dashboard endpoints (no auth if unset)
# Recommended: use a long random string (openssl rand -hex 32)
# AGENTSGATE_API_KEY=

# ── Multi-Tenant ───────────────────────────────────────────────────────────────
# Team namespace for database isolation (creates data-{team}.db)
# AGENTSGATE_TEAM=

# ── Database ───────────────────────────────────────────────────────────────────
# Path to SQLite database file (default: ~/.agentsgate/data.db)
# AGENTSGATE_DB_PATH=

# ── Audit Log ──────────────────────────────────────────────────────────────────
# HMAC secret for audit log integrity verification
# Required to use: agentsgate report --format=json --verify
# Recommended: use a long random string (openssl rand -hex 32)
# AGENTSGATE_AUDIT_SECRET=

# ── Policy ─────────────────────────────────────────────────────────────────────
# Path to policy JSON file (default: ~/.agentsgate/policy.json)
# AGENTSGATE_POLICY_PATH=

# ── WebSocket Gateway ──────────────────────────────────────────────────────────
# Port for live operation streaming via WebSocket (default: disabled)
# AGENTSGATE_WS_PORT=

# ── Telemetry ──────────────────────────────────────────────────────────────────
# Endpoint to export telemetry data (optional)
# AGENTSGATE_TELEMETRY_ENDPOINT=

# Webhook URL to call when anomaly detected (optional)
# AGENTSGATE_ANOMALY_WEBHOOK_URL=

# Z-score threshold for anomaly detection (default: 3.0)
# AGENTSGATE_ANOMALY_THRESHOLD=3.0

# ── RBAC Roles ─────────────────────────────────────────────────────────────────
# Map API keys to roles: viewer, approver, or admin
# Format: KEY:ROLE,KEY:ROLE (comma-separated)
# AGENTSGATE_ROLES=viewerkey123:viewer,approverkey456:approver,adminkey789:admin
