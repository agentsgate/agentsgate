# AgentsGate reverse-proxy template (HTTPS via Let's Encrypt / manual cert)
# Place this in /etc/nginx/sites-available/agentsgate and symlink to sites-enabled/
# Then: sudo certbot --nginx -d agentsgate.example.com

server {
    listen 80;
    server_name agentsgate.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name agentsgate.example.com;

    ssl_certificate     /etc/letsencrypt/live/agentsgate.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentsgate.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Verify incoming AgentsGate webhook signatures:
    # X-AgentsGate-Signature: sha256=<hex>
    # HMAC-SHA256(webhookSecret, rawBody)

    # Dashboard API & UI
    location / {
        proxy_pass         http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
